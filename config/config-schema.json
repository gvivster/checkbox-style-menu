{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"checkboxStyles": {
			"type": "array",
			"description": "Array of available checkbox styles",
			"items": {
				"type": "object",
				"properties": {
					"symbol": {
						"type": "string",
						"description": "The checkbox symbol (single character)",
						"minLength": 1,
						"maxLength": 1
					},
					"description": {
						"type": "string",
						"description": "Human-readable description of the checkbox style"
					}
				},
				"required": ["symbol", "description"]
			}
		},
		"compatibilitySettings": {
			"type": "object",
			"description": "Settings for plugin compatibility features",
			"properties": {
				"enableTasksCompatibility": {
					"type": "boolean",
					"description": "Whether to enable Tasks plugin integration",
					"default": false
				},
				"hasShownTasksNotice": {
					"type": "boolean",
					"description": "Whether the Tasks plugin notice has been shown to the user",
					"default": false
				}
			},
			"required": ["enableTasksCompatibility", "hasShownTasksNotice"]
		}
	},
	"required": ["checkboxStyles", "compatibilitySettings"]
}